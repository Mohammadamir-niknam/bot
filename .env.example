# telBotPropo environment configuration
# Copy this file to .env and fill secure production values.

APP_NAME=telBotPropo
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/telbotpropo.log

# Telegram
BOT_TOKEN=123456789:CHANGE_ME
BOT_PARSE_MODE=HTML
BOT_DROP_PENDING_UPDATES=true

# Initial super admins as comma-separated Telegram user IDs.
SUPER_ADMIN_IDS=123456789

# Cloudflare Worker Telegram Bot API proxy endpoints.
# Example: https://telegram-proxy.example.workers.dev/bot{token}/{method}
# Aiogram base_url must point to the API root accepted by AiohttpSession.
PROXY_URL_1=
PROXY_URL_2=
PROXY_URL_3=
PROXY_TIMEOUT_SECONDS=12
PROXY_HEALTHCHECK_ENABLED=true
ALLOW_DIRECT_TELEGRAM_FALLBACK=false

# Database. SQLite is suitable for local development only.
DATABASE_URL=sqlite+aiosqlite:///./telbotpropo.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://telbotpropo:CHANGE_ME@postgres:5432/telbotpropo
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800

# Optional Redis for production rate limits / FSM storage.
REDIS_URL=
REDIS_PREFIX=telbotpropo

# Security and runtime controls.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=30
UPLOAD_MAX_BYTES=5242880
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png
BACKUP_DIR=backups
